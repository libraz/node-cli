{
  "name": "@libraz/node-cli",
  "version": "1.3.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "author": "libraz <libraz@libraz.net>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/libraz/node-cli.git"
  },
  "homepage": "https://github.com/libraz/node-cli",
  "bugs": "https://github.com/libraz/node-cli/issues",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "biome check src tests",
    "lint:fix": "biome check --write src tests",
    "format": "biome format --write src tests",
    "check": "biome check --write src tests",
    "prepack": "cp README.md .readme-backup && cp README.npm.md .npm-readme-backup && cp README.npm.md README.md && rm README.npm.md",
    "postpack": "mv .readme-backup README.md && mv .npm-readme-backup README.npm.md"
  },
  "volta": {
    "node": "24.18.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "packageManager": "yarn@4.17.0"
}
