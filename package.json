{
  "name": "@libraz/node-cli",
  "version": "2.0.0",
  "description": "Zero-dependency, batteries-included CLI framework for Node.js / TypeScript.",
  "keywords": ["cli", "command-line", "repl", "interactive-shell", "prompts", "progress", "typescript"],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "license": "MIT",
  "author": "libraz <libraz@libraz.net>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/libraz/node-cli.git"
  },
  "homepage": "https://github.com/libraz/node-cli",
  "bugs": "https://github.com/libraz/node-cli/issues",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "pretest": "yarn build",
    "test": "yarn build && vitest",
    "test:coverage": "vitest --coverage",
    "test:examples": "node scripts/examples-smoke.mjs",
    "test:git-install": "node scripts/git-install-smoke.mjs",
    "test:pack": "node scripts/pack-smoke.mjs",
    "typecheck:examples": "tsc -p tsconfig.examples.json",
    "typecheck:min-ts": "node scripts/typecheck-min-ts.mjs",
    "typecheck:min-types": "node scripts/typecheck-min-types.mjs",
    "typecheck:types": "node scripts/typecheck-types.mjs",
    "lint": "biome check src tests examples scripts",
    "lint:fix": "biome check --write src tests examples scripts",
    "format": "biome format --write src tests examples scripts",
    "check": "biome check --write src tests examples scripts",
    "prepare": "tsc",
    "prepack": "yarn build && node scripts/pack-readme.mjs prepare",
    "postpack": "node scripts/pack-readme.mjs restore"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@types/node": ">=22"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": true
    }
  },
  "packageManager": "yarn@4.18.1"
}
